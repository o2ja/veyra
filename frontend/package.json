{
  "name": "veyra-recover-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "gen:api": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tanstack/react-query": "5.107.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
