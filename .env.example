# Placeholders only. Create a real .env with `make env` (random local-only secrets). Never commit .env.
# `replace-me` is deliberately shorter than SECRET_KEY's minimum, so an unreplaced value fails at startup.
APP_ENV=local
LOG_LEVEL=INFO
SECRET_KEY=replace-me
# MFA secret encryption (kid:base64 32-byte key; first = active). `make env` generates one.
ENCRYPTION_KEYS=replace-me-encryption-keys

# Host port for the dev Postgres container (5432 by default; use another if a local Postgres runs).
POSTGRES_HOST_PORT=5432
POSTGRES_PASSWORD=replace-me
REBATE_OWNER_PASSWORD=replace-me
REBATE_APP_PASSWORD=replace-me
REBATE_AI_WRITER_PASSWORD=replace-me
REBATE_READONLY_PASSWORD=replace-me
