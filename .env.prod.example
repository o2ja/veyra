# Production/staging environment template (infra/docker/compose.prod.yml). Placeholders only.
# Copy to the server as `.env.prod` (chmod 0600, owned by the deploy user); never commit real values.
# Use URL-safe passwords (letters, digits, - and _): they are embedded in database URLs.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ENV=production
LOG_LEVEL=INFO
REBATE_IMAGE_TAG=replace-me
# Single source of truth for WHICH database and bucket the stack uses (compose builds DATABASE_URL* from the
# name). Runbooks switch to a restored copy by editing these two lines, never a URL.
REBATE_DB_NAME=rebate

# Public hostnames (Cloudflare proxied). APP_DOMAIN serves the SPA and API, S3_DOMAIN the presigned object URLs.
APP_DOMAIN=app.example.com
S3_DOMAIN=files.example.com
PUBLIC_BASE_URL=https://app.example.com
S3_PUBLIC_ENDPOINT_URL=https://files.example.com

SECRET_KEY=replace-me
# kid:base64(32 bytes); the first entry is active (DEPLOYMENT.md section 2.4)
ENCRYPTION_KEYS=k1:replace-me

# Postgres. The superuser password is used by init-db.sh and backups only; the app never sees it.
POSTGRES_PASSWORD=replace-me
REBATE_OWNER_PASSWORD=replace-me
REBATE_APP_PASSWORD=replace-me
REBATE_AI_WRITER_PASSWORD=replace-me
REBATE_READONLY_PASSWORD=replace-me

# Object store
S3_BUCKET=rebate-files
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Separate admin identity: out-of-band bucket provisioning and restore.sh only; never given to api/worker
S3_ADMIN_ACCESS_KEY_ID=replace-me
S3_ADMIN_SECRET_ACCESS_KEY=replace-me
# 64 hex chars
SEAWEEDFS_SSE_KEY=replace-me

# Caddy's fixed address on the INTERNAL network (compose.prod.yml), the peer address the api sees.
# CI (infra/scripts/check-proxy-config.py) fails if this does not match. See core/clientip.py.
TRUSTED_PROXY_IPS=172.30.1.2
# Cloudflare edge ranges: copy https://www.cloudflare.com/ips-v4 and ips-v6, comma-separated
# (infra/runbooks/cloudflare-ip-update.md)
CLOUDFLARE_IP_RANGES=replace-me

# Mail (STARTTLS is mandatory in staging/production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
MAIL_FROM=Veyra Recover <no-reply@example.com>
